{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel",
  "functions": {
    "api/classroom.mjs": {
      "maxDuration": 60,
      "includeFiles": "drizzle/*.sql"
    }
  },
  "rewrites": [
    { "source": "/api/classroom/:path*", "destination": "/api/classroom?route=:path*" },
    { "source": "/manage", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/((?!python-worker\\.mjs).*)",
      "headers": [{ "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'self'" }]
    },
    {
      "source": "/python-worker.mjs",
      "headers": [{ "key": "Content-Security-Policy", "value": "default-src 'none'; script-src https://cdn.jsdelivr.net/pyodide/v314.0.7/full/ 'wasm-unsafe-eval'; connect-src https://cdn.jsdelivr.net/pyodide/v314.0.7/full/; worker-src 'none'" }]
    }
  ]
}
