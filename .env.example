# Never put these values in public files. Runtime secrets are configured only on the server.
ADMIN_PASSWORD=replace-with-a-random-secret-of-at-least-16-characters
MODEL_MODE=demo
# Configure only when ready to connect a real model. No fake fallback in live mode.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# Vercel only: use a persistent Turso database. Never expose these in frontend variables.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
